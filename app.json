{
  "expo": {
    "name": "Ledgeria",
    "slug": "aru-finance-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/appstore-icon.png",
    "scheme": "arufinanceapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.alfredoptarigan.arufintech",
      "icon": "./assets/images/appstore-icon.png"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/images/playstore-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/playstore-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.alfredoptarigan.arufintech"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ledgeria uses your photos to scan receipts.",
          "cameraPermission": "Ledgeria uses your camera to scan receipts.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6557c08f-563d-4b06-825c-f3782f5a625e"
      }
    },
    "owner": "alfredoptr28"
  }
}
